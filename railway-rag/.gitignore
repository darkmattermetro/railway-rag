# API keys — any file matching this pattern
api keys*
API keys*
*api*key*
secrets*

# Python
__pycache__/
*.pyc
*.pyo
venv*/
.env
*.egg-info/

# Vector indices (rebuilt from PDFs) — keep only MRGR_index
vector_indices/*
!vector_indices/MRGR_index/
!vector_indices/SPECIAL_INSTRUCTIONS_index/
!vector_indices/Safety_Circular_index/
!vector_indices/RS10_index/
!vector_indices/SOP_OCC_index/

# CodeGraph AI cache
.codegraph/

# Backups
*.original
*_backup_*

# Large test fixtures
test_pdfs/test_real.pdf

# Misc generated files
constraints.txt
requirements_fixed.txt

# IDE
.idea/
.vscode/

# OS
Thumbs.db
.DS_Store

# Chunk cache (resumable ingestion)
.chunks_cache/

# Logs
*.log
*.err
streamlit_out.txt
streamlit_err.txt
